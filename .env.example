NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/job_alert
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION=1d

# Browser origins allowed to call the API (public site, admin panel)
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
# Behind nginx / Render / a load balancer: 1, so rate limiting sees real client IPs
TRUST_PROXY=1

# Optional: on-demand ISR webhook to the public site (instant updates after publish)
FRONTEND_REVALIDATE_URL=http://localhost:3000/internal/revalidate
REVALIDATE_SECRET=change-me-shared-secret

# Log files rotate by size so they can never fill the disk (defaults shown):
# combined.log keeps the newest 10 MB, up to 5 files; error.log half that size. ~75 MB max in total.
# LOG_DIR=logs
# LOG_MAX_SIZE_MB=10
# LOG_MAX_FILES=5
# LOG_LEVEL=info
# Console only (Render/Docker already capture stdout): LOG_TO_FILE=false
# LOG_TO_FILE=true

# Gemini AI API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ───────── Automatic crawler (discover -> AI extract -> quality gate -> publish) ─────────
# Run the crawler on a timer (every CRAWLER_INTERVAL_MINUTES, minimum 15).
ENABLE_CRAWLER_SCHEDULER=false
CRAWLER_INTERVAL_MINUTES=120
# Candidates examined per source per run, and AI extractions per run (each one costs money,
# failed attempts count too).
CRAWLER_LIMIT_PER_RUN=15
CRAWLER_MAX_AI_PER_RUN=5

# Publish posts with NO human review when they pass every automatic check (see
# src/app/scraper/quality-gate.ts). Posts that fail stay in "review" with the reasons shown in
# the admin. KEEP "false" until you have watched a few runs. Set to "false" at any time as a kill switch.
CRAWLER_AUTO_PUBLISH=false
# The model must report at least this much confidence (0-100) that every field is in the source.
CRAWLER_MIN_CONFIDENCE=70
# Hard cap on automatic publications per rolling 24h.
CRAWLER_MAX_AUTO_PUBLISH_PER_DAY=30

# Politeness / reliability
CRAWLER_DELAY_MS=1500
CRAWLER_MAX_ATTEMPTS=3
# Identify your bot to site owners (optional), e.g. "Mozilla/5.0 (compatible; MyBot/1.0; +https://yoursite.com/bot)"
# CRAWLER_USER_AGENT=
