NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/job_alert
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION=1d

# Browser origins allowed to call the API (public site, admin panel)
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
# Behind nginx / Render / a load balancer: 1, so rate limiting sees real client IPs
TRUST_PROXY=1

# Optional: on-demand ISR webhook to the public site (instant updates after publish)
FRONTEND_REVALIDATE_URL=http://localhost:3000/internal/revalidate
REVALIDATE_SECRET=change-me-shared-secret
